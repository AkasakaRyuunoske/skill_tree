        <UserObject label="&lt;img src=&quot;https://wikimedia.org/api/rest_v1/media/math/render/svg/4ea14008c326f2fb428ccdf8f7a8d1fe5cbde8d3&quot; alt=&quot;\color [rgb]{0.6392156862745098,0.5529411764705883,0.42745098039215684}{\begin{aligned}a&amp;amp;{\text{ the total amount of added stats }}&amp;amp;a&amp;amp;\in \mathbb {N} _{0}\\b&amp;amp;{\text{ the total amount of increased stats }}&amp;amp;b&amp;amp;\in \mathbb {N} _{0}\\c&amp;amp;{\text{ the total amount of reduced stats }}&amp;amp;c&amp;amp;\in \mathbb {N} _{0}\\d&amp;amp;{\text{ the total amount of more stats }}&amp;amp;d&amp;amp;\in \mathbb {N} _{0}\\e&amp;amp;{\text{ the total amount of less stats }}&amp;amp;e&amp;amp;\in \mathbb {N} _{0}\\\end{aligned}}&quot;&gt;" link="&lt;img src=&quot;https://wikimedia.org/api/rest_v1/media/math/render/svg/4ea14008c326f2fb428ccdf8f7a8d1fe5cbde8d3&quot; alt=&quot;\color [rgb]{0.6392156862745098,0.5529411764705883,0.42745098039215684}{\begin{aligned}a&amp;amp;{\text{ the total amount of added stats }}&amp;amp;a&amp;amp;\in \mathbb {N} _{0}\\b&amp;amp;{\text{ the total amount of increased stats }}&amp;amp;b&amp;amp;\in \mathbb {N} _{0}\\c&amp;amp;{\text{ the total amount of reduced stats }}&amp;amp;c&amp;amp;\in \mathbb {N} _{0}\\d&amp;amp;{\text{ the total amount of more stats }}&amp;amp;d&amp;amp;\in \mathbb {N} _{0}\\e&amp;amp;{\text{ the total amount of less stats }}&amp;amp;e&amp;amp;\in \mathbb {N} _{0}\\\end{aligned}}&quot;&gt;" id="RvfAqYBo0s0PT-qtyjex-18">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
