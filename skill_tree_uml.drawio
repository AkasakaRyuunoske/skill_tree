        <mxCell id="RvfAqYBo0s0PT-qtyjex-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;div&gt;&lt;b&gt;Describes how allocation of a node should affect node&#39;s affected stats&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FLAT -&amp;gt; &lt;/b&gt;Adds a flat value (i.e value used at the start of calculations)&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PERCENT_INCREASE -&amp;gt; &lt;/b&gt;A percentual increment to a flat value&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;MULTIPLIER_INCREASE -&amp;gt;&lt;/b&gt;&amp;nbsp;A multiplicative increase&lt;/div&gt;" vertex="1">
