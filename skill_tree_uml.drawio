        <mxCell id="RvfAqYBo0s0PT-qtyjex-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Describes all possible states a node can be in&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;b&gt;AVAILABLE -&amp;gt;&lt;/b&gt; All requirements for node allocation are met, but node is not yet allocated.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;ALLOCATED -&amp;gt;&lt;/b&gt; Node is allocated&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;LOCKED -&amp;gt; &lt;/b&gt;One or more conditions for node allocation are not satisfied&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;TRANSFORMED -&amp;gt;&amp;nbsp;&lt;/b&gt;Node is transformed as outcome of a influence/tattoo&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="340" x="570" y="1740" as="geometry" />
