        <mxCell id="RvfAqYBo0s0PT-qtyjex-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;div&gt;&lt;b&gt;Describes how allocation of a node should affect node&#39;s affected stats&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FLAT -&amp;gt; &lt;/b&gt;Adds a flat value (i.e value used at the start of calculations)&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PERCENT_INCREASE -&amp;gt; &lt;/b&gt;A percentual increment to a flat value&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;MULTIPLIER_INCREASE -&amp;gt;&lt;/b&gt;&amp;nbsp;A multiplicative increase&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="270" x="570" y="1420" as="geometry" />
        </mxCell>
        <UserObject label="&lt;img src=&quot;https://wikimedia.org/api/rest_v1/media/math/render/svg/9fb916341869c02c34a0e8972ffde069b363d624&quot; alt=&quot;\color [rgb]{0.6392156862745098,0.5529411764705883,0.42745098039215684}{\begin{aligned}{\text{stat}}_{total}=&amp;amp;\sum _{i=1}^{a}{\text{added stat}}_{i}\times \\&amp;amp;\left(1+\sum _{j=1}^{b}{\text{increased stat}}_{j}-\sum _{k=1}^{c}{\text{reduced stat}}_{k}\right)\times \\&amp;amp;\prod _{l=1}^{d}(1+{\text{more stat}}_{l})\times \prod _{m=1}^{e}(1-{\text{less stat}}_{m})\end{aligned}}&quot;&gt;" link="&lt;img src=&quot;https://wikimedia.org/api/rest_v1/media/math/render/svg/9fb916341869c02c34a0e8972ffde069b363d624&quot; alt=&quot;\color [rgb]{0.6392156862745098,0.5529411764705883,0.42745098039215684}{\begin{aligned}{\text{stat}}_{total}=&amp;amp;\sum _{i=1}^{a}{\text{added stat}}_{i}\times \\&amp;amp;\left(1+\sum _{j=1}^{b}{\text{increased stat}}_{j}-\sum _{k=1}^{c}{\text{reduced stat}}_{k}\right)\times \\&amp;amp;\prod _{l=1}^{d}(1+{\text{more stat}}_{l})\times \prod _{m=1}^{e}(1-{\text{less stat}}_{m})\end{aligned}}&quot;&gt;" id="RvfAqYBo0s0PT-qtyjex-17">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
